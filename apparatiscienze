<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Skill Typing - Missione Scienze & Custom</title>
    <style>
        /* ==========================================================================
           RESET E VARIABILI CSS (DESIGN SYSTEM PRO)
           ========================================================================== */
        :root {
            --bg-dark: #0f172a;
            --card-bg: rgba(30, 41, 59, 0.95);
            --primary: #06b6d4;
            --primary-hover: #0891b2;
            --primary-light: #67e8f9;
            --accent: #f59e0b;
            --accent-hover: #d97706;
            --success: #10b981;
            --danger: #ef4444;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --border-color: #334155;
            --font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font-family);
            background: radial-gradient(circle at top, #1e293b 0%, #0f172a 100%);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        /* ==========================================================================
           CONTAINER E STRUTTURA PRINCIPALE
           ========================================================================== */
        .container {
            width: 100%;
            max-width: 900px;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 1.5rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            padding: 2rem;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
        }

        .hidden { display: none !important; }

        /* ==========================================================================
           BANNER DI AVVISO / NOTIFICA INTEGRATO
           ========================================================================== */
        .notice-banner {
            border-radius: 0.85rem;
            padding: 0.85rem 1rem;
            margin-bottom: 1.15rem;
            font-size: 0.9rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            border: 1px solid transparent;
        }

        .notice-banner.error {
            background: rgba(239, 68, 68, 0.14);
            border-color: rgba(239, 68, 68, 0.5);
            color: #fca5a5;
        }

        .notice-banner.success {
            background: rgba(16, 185, 129, 0.14);
            border-color: rgba(16, 185, 129, 0.5);
            color: #6ee7b7;
        }

        .notice-banner.info {
            background: rgba(6, 182, 212, 0.14);
            border-color: rgba(6, 182, 212, 0.5);
            color: #a5f3fc;
        }

        .notice-close {
            background: transparent;
            border: none;
            color: inherit;
            font-size: 1.1rem;
            font-weight: 800;
            cursor: pointer;
            line-height: 1;
            padding: 0 0.25rem;
        }

        /* ==========================================================================
           HERO BANNER ILLUSTRATO (STILE CYBER-SCIENTIFICO)
           ========================================================================== */
        .hero-banner {
            width: 100%;
            border-radius: 1.15rem;
            overflow: hidden;
            border: 1px solid rgba(6, 182, 212, 0.4);
            box-shadow: 0 12px 30px -5px rgba(6, 182, 212, 0.25), inset 0 0 20px rgba(6, 182, 212, 0.15);
            margin-bottom: 1.25rem;
            background: #060d1f;
            position: relative;
        }

        .hero-banner svg {
            display: block;
            width: 100%;
            height: auto;
        }

        @keyframes floatKey {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-4px); }
        }

        .svg-float-1 { animation: floatKey 3s ease-in-out infinite; }
        .svg-float-2 { animation: floatKey 3.4s ease-in-out infinite 0.4s; }
        .svg-float-3 { animation: floatKey 2.8s ease-in-out infinite 0.8s; }

        .system-layer {
            opacity: 0;
            transition: opacity 0.35s ease;
        }

        .system-layer.active-layer {
            opacity: 1;
        }

        /* ==========================================================================
           TYPOGRAPHY & UTILITIES
           ========================================================================== */
        h1.report-title {
            text-align: center;
            font-size: 2rem;
            font-weight: 800;
            background: linear-gradient(135deg, var(--primary-light), #3b82f6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 0.25rem;
            letter-spacing: -0.025em;
        }

        p.description {
            text-align: center;
            color: var(--text-muted);
            margin-bottom: 1.25rem;
            font-size: 0.98rem;
        }

        /* ==========================================================================
           SCHEDE (TABS) DI SELEZIONE MODALITÀ
           ========================================================================== */
        .tabs-nav {
            display: flex;
            gap: 0.5rem;
            background: rgba(15, 23, 42, 0.8);
            padding: 0.4rem;
            border-radius: 1rem;
            border: 1px solid var(--border-color);
            margin-bottom: 1.25rem;
        }

        .tab-btn {
            flex: 1;
            padding: 0.75rem 1rem;
            border: none;
            border-radius: 0.75rem;
            background: transparent;
            color: var(--text-muted);
            font-weight: 700;
            font-size: 0.95rem;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .tab-btn:hover {
            color: var(--text-main);
            background: rgba(255, 255, 255, 0.05);
        }

        .tab-btn.active {
            background: linear-gradient(135deg, var(--primary), #2563eb);
            color: white;
            box-shadow: 0 4px 12px rgba(6, 182, 212, 0.35);
        }

        /* ==========================================================================
           SELETTORE APPARATI SCIENTIFICI
           ========================================================================== */
        .systems-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0.65rem;
            margin-bottom: 1rem;
        }

        @media (max-width: 720px) {
            .systems-grid { grid-template-columns: repeat(2, 1fr); }
        }

        @media (max-width: 460px) {
            .systems-grid { grid-template-columns: 1fr; }
        }

        .system-chip {
            background: #0f172a;
            border: 1px solid var(--border-color);
            border-radius: 0.8rem;
            padding: 0.7rem 0.85rem;
            color: var(--text-main);
            font-size: 0.88rem;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.55rem;
            text-align: left;
            transition: all 0.2s ease;
        }

        .system-chip:hover {
            border-color: var(--primary);
            background: rgba(6, 182, 212, 0.08);
            transform: translateY(-1px);
        }

        .system-chip.selected {
            background: rgba(6, 182, 212, 0.18);
            border-color: var(--primary-light);
            color: var(--primary-light);
            box-shadow: 0 0 0 2px rgba(6, 182, 212, 0.25);
        }

        .system-preview {
            background: rgba(9, 13, 22, 0.75);
            border: 1px dashed rgba(103, 232, 249, 0.35);
            border-radius: 0.75rem;
            padding: 0.75rem 0.95rem;
            font-size: 0.84rem;
            color: var(--text-muted);
        }

        .system-preview strong {
            color: var(--accent);
        }

        /* ==========================================================================
           FORM E PULSANTI
           ========================================================================== */
        .form-card, .rules-card {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid var(--border-color);
            border-radius: 1rem;
            padding: 1.25rem;
            margin-bottom: 1.25rem;
        }

        .form-card h3, .rules-card h3 {
            color: var(--primary-light);
            margin-bottom: 1rem;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .input-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        @media (max-width: 600px) {
            .input-group { grid-template-columns: 1fr; }
            .tabs-nav { flex-direction: column; }
            .container { padding: 1.25rem; }
        }

        label {
            display: block;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            color: var(--text-muted);
            margin-bottom: 0.35rem;
        }

        input[type="text"], textarea {
            width: 100%;
            background: #0f172a;
            border: 1px solid var(--border-color);
            border-radius: 0.75rem;
            padding: 0.75rem 1rem;
            color: white;
            font-size: 1rem;
            font-family: inherit;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        textarea {
            resize: vertical;
            min-height: 130px;
            line-height: 1.5;
        }

        input[type="text"]:focus, textarea:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.25);
        }

        .custom-actions {
            display: flex;
            gap: 0.75rem;
            margin-top: 0.75rem;
            flex-wrap: wrap;
        }

        .btn-secondary {
            background: #1e293b;
            color: var(--primary-light);
            border: 1px solid var(--border-color);
            padding: 0.65rem 1rem;
            border-radius: 0.75rem;
            font-size: 0.85rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            flex: 1;
        }

        .btn-secondary:hover {
            background: #334155;
            border-color: var(--primary);
        }

        .btn-export {
            background: rgba(245, 158, 11, 0.15);
            color: var(--accent);
            border-color: rgba(245, 158, 11, 0.4);
        }

        .btn-export:hover {
            background: rgba(245, 158, 11, 0.25);
            border-color: var(--accent);
        }

        .helper-note {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-top: 0.5rem;
